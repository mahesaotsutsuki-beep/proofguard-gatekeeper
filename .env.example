# Copy to .env and fill in. Never commit .env (it is gitignored).
# HMAC secret for the agent endpoint, from the Agent Games dashboard
# ("Rotate Secret" on your agent). AGENT_HMAC_SECRET is also accepted.
# When unset the server falls back to a dev secret with a warning —
# never use the fallback live.
AGENT_GAMES_HMAC_SECRET=
# Port the agent listens on.
PORT=3000
